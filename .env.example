# InstaRAG Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API (Required)
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_DEFAULT_MODEL=gpt-5.4-mini-2026-03-17

# Database Configuration (Required for multi-workspace support)
DATABASE_URL=postgresql+psycopg://cn37@localhost:5432/app_to_infra

# Firecrawl Integration (Optional - for URL scraping)
FIRECRAWL_API_KEY=fc-your-firecrawl-key
# Security & Administration